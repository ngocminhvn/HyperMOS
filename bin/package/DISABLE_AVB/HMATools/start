#!/bin/bash
ROOT_DIR=$(realpath "$(dirname "$0")/../../../../")
HMA_DIR=$(realpath "$(dirname "$0")")

source "$ROOT_DIR/functions.sh"

PENGUIN_REF="e2e1106f7443bd9dcfbf7264b538990eab9b32a0"
PENGUIN_RAW="https://raw.githubusercontent.com/lth1503ahihi/PenguinOS/$PENGUIN_REF/bin/package/DISABLE_AVB/HMATools"

sync_penguin_binary() {
    local rel="$1"
    local expected_size="$2"
    local target="$HMA_DIR/$rel"
    local tmp="$target.penguin.tmp"

    mkdir -p "$(dirname "$target")"
    rm -f "$tmp"

    aria2c         --allow-overwrite=true         --auto-file-renaming=false         -x 8 -s 8         -d "$(dirname "$target")"         -o "$(basename "$tmp")"         "$PENGUIN_RAW/$rel" >/dev/null 2>&1 || {
            error "HMATools: failed to sync PenguinOS binary $rel"
            return 1
        }

    [[ -s "$tmp" ]] || {
        error "HMATools: downloaded binary is empty: $rel"
        rm -f "$tmp"
        return 1
    }

    local actual_size
    actual_size=$(stat -c%s "$tmp")
    [[ "$actual_size" == "$expected_size" ]] || {
        error "HMATools: size mismatch for $rel ($actual_size != $expected_size)"
        rm -f "$tmp"
        return 1
    }

    mv -f "$tmp" "$target"
}

# Sync exact PenguinOS runtime binaries from the pinned source commit.
sync_penguin_binary "bbootimg.jar" "26004287" || exit 1
sync_penguin_binary "aosp/apksigner/build/libs/apksigner-1.0.jar" "1469705" || exit 1
sync_penguin_binary "aosp/boot_signer/build/libs/boot_signer.jar" "6434680" || exit 1
info "HMATools: PenguinOS runtime binaries synced"

UNPACK="java -jar $HMA_DIR/bbootimg.jar unpack"
REPACK="java -jar $HMA_DIR/bbootimg.jar pack"
CLEAN="java -jar $HMA_DIR/bbootimg.jar clear"

chmod -R +x "$HMA_DIR/aosp" 2>/dev/null || true
cd "$HMA_DIR" || exit 1

patch_image() {
    local image_name="$1"
    local source="$ROOT_DIR/build/baserom/images/$image_name"

    [[ -f "$source" ]] || return 0

    patch "Found $image_name! Patching..."
    cp -f "$source" "$HMA_DIR/$image_name" || return 1

    patch "Start Process..."
    if ! $UNPACK >/dev/null 2>&1; then
        error "HMATools: failed to unpack $image_name"
        return 1
    fi

    local clear_file="build/unzip_boot/intermediate/$image_name.clear"
    [[ -f "$clear_file" ]] && cp -f "$clear_file" . || true

    disable_avb_verify "$HMA_DIR/build/unzip_boot" >/dev/null 2>&1 || true

    if ! $REPACK >/dev/null 2>&1; then
        error "HMATools: failed to repack $image_name"
        return 1
    fi

    if [[ -f "$HMA_DIR/$image_name.signed" ]]; then
        mv -f "$HMA_DIR/$image_name.signed" "$HMA_DIR/$image_name"
    fi

    [[ -s "$HMA_DIR/$image_name" ]] || {
        error "HMATools: output missing for $image_name"
        return 1
    }

    cp -f "$HMA_DIR/$image_name" "$source" || return 1
    patch "Patching ${image_name%.*} Successfully!"

    $CLEAN >/dev/null 2>&1 || true
    return 0
}

patch_image "boot.img" || exit 1
patch_image "vendor_boot.img" || exit 1

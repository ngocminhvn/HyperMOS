#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR=$(realpath "$(dirname "$0")/../../../../")
HMA_DIR=$(realpath "$(dirname "$0")")
source "$ROOT_DIR/functions.sh"
LOG_DIR="$ROOT_DIR/build/diagnostics/hmatools"
mkdir -p "$LOG_DIR"
chmod -R +x "$HMA_DIR/aosp"
cd "$HMA_DIR"

run_hma() {
    local phase="$1" image="$2" rc
    if java -jar "$HMA_DIR/bbootimg.jar" "$phase" >"$LOG_DIR/$image.$phase.log" 2>&1; then
        return 0
    else
        rc=$?
        error "HMATools $image $phase failed (rc=$rc)"
        tail -n 100 "$LOG_DIR/$image.$phase.log" >&2
        return "$rc"
    fi
}

for image in boot.img vendor_boot.img; do
    source_image="$ROOT_DIR/build/baserom/images/$image"
    [ -f "$source_image" ] || continue

    # Pre-clean stale HMATools state without invoking bbootimg.jar clear.
    # The clear command uses lazy handler detection and fails with rc=2 when
    # no boot/vendor_boot image is present in HMATools' working directory.
    rm -rf "$HMA_DIR/build"
    rm -f boot.img vendor_boot.img boot.img.signed vendor_boot.img.signed

    cp -f "$source_image" "$image"
    before=$(sha256sum "$source_image" | cut -d ' ' -f1)

    run_hma unpack "$image"
    if [ ! -d build/unzip_boot ]; then
        error "HMATools $image: unpack succeeded without build/unzip_boot"
        exit 1
    fi

    disable_avb_verify "$HMA_DIR/build/unzip_boot" >"$LOG_DIR/$image.fstab.log" 2>&1
    run_hma pack "$image"

    # bbootimg/HMATools output differs by image/tool version:
    # some builds create <image>.signed, while newer cfig builds write the
    # final signed/repacked image directly back to <image>.
    if [ -s "$image.signed" ]; then
        packed_image="$image.signed"
    elif [ -s "$image" ]; then
        packed_image="$image"
        warn "HMATools $image: $image.signed not produced; using repacked $image (PenguinOS-compatible fallback)"
    else
        error "HMATools $image: pack produced neither $image.signed nor $image"
        tail -n 100 "$LOG_DIR/$image.pack.log" >&2
        find build/unzip_boot -maxdepth 3 -type f -name '*.img*' -printf '%P\n' >&2
        exit 1
    fi

    after=$(sha256sum "$packed_image" | cut -d ' ' -f1)
    cp -f "$packed_image" "$source_image"
    info "HMATools $image: input=$before output=$after via $(basename "$packed_image") (hashes do not assert signature trust)"

    # At this point $image exists, so HMATools can resolve the correct handler.
    run_hma clear "$image"
done

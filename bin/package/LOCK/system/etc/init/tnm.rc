# TNM LOCK: RYUOS helper, only the three previously selected properties.
on post-fs
    exec u:r:init:s0 root root -- /system_ext/xbin/ryu_helper -n ro.boot.flash.locked 1
    exec u:r:init:s0 root root -- /system_ext/xbin/ryu_helper -n ro.boot.vbmeta.device_state locked
    exec u:r:init:s0 root root -- /system_ext/xbin/ryu_helper -n ro.boot.verifiedbootstate green

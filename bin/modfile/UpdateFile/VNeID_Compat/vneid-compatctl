#!/system/bin/sh
# HyperMOS VNeID compatibility diagnostics
# Read-only: reports the environment seen by com.vnid. No spoofing or policy mutation.

STATE=/data/adb/vneid_compat
PKG=com.vnid
PATH=/system/bin:/system/xbin:/system_ext/bin:/product/bin:/vendor/bin
export PATH
umask 077

prop() { getprop "$1" 2>/dev/null; }
val() { [ -n "$1" ] && printf '%s\n' "$1" || printf '%s\n' "-"; }

package_installed() {
    pm path "$PKG" >/dev/null 2>&1
}

package_info() {
    if ! package_installed; then
        echo "package=$PKG"
        echo "installed=false"
        return
    fi
    echo "package=$PKG"
    echo "installed=true"
    path="$(pm path "$PKG" 2>/dev/null | head -n 1 | sed 's/^package://')"
    echo "apk_path=$(val "$path")"
    dump="$(dumpsys package "$PKG" 2>/dev/null)"
    version_name="$(printf '%s\n' "$dump" | sed -n 's/^[[:space:]]*versionName=//p' | head -n 1)"
    version_code="$(printf '%s\n' "$dump" | sed -n -E 's/^[[:space:]]*versionCode=([^[:space:]]+).*/\1/p' | head -n 1)"
    uid="$(printf '%s\n' "$dump" | sed -n -E 's/^[[:space:]]*userId=([0-9]+).*/\1/p' | head -n 1)"
    echo "version_name=$(val "$version_name")"
    echo "version_code=$(val "$version_code")"
    echo "uid=$(val "$uid")"
}

identity_info() {
    echo "device=$(val "$(prop ro.product.vendor.device)")"
    echo "model=$(val "$(prop ro.product.vendor.model)")"
    echo "brand=$(val "$(prop ro.product.vendor.brand)")"
    echo "manufacturer=$(val "$(prop ro.product.vendor.manufacturer)")"
    echo "product_name=$(val "$(prop ro.product.vendor.name)")"
    echo "mod_device=$(val "$(prop ro.product.mod_device)")"
    echo "android=$(val "$(prop ro.build.version.release)")"
    echo "sdk=$(val "$(prop ro.build.version.sdk)")"
    echo "security_patch=$(val "$(prop ro.build.version.security_patch)")"
    echo "fingerprint=$(val "$(prop ro.build.fingerprint)")"
    echo "vendor_fingerprint=$(val "$(prop ro.vendor.build.fingerprint)")"
    echo "odm_fingerprint=$(val "$(prop ro.odm.build.fingerprint)")"
    echo "kernel=$(uname -r 2>/dev/null || echo -)"
}

security_info() {
    echo "flash_locked=$(val "$(prop ro.boot.flash.locked)")"
    echo "verifiedbootstate=$(val "$(prop ro.boot.verifiedbootstate)")"
    echo "vbmeta_device_state=$(val "$(prop ro.boot.vbmeta.device_state)")"
    echo "secureboot=$(val "$(prop ro.boot.secureboot)")"
    echo "warranty_bit=$(val "$(prop ro.boot.warranty_bit)")"
    echo "oem_unlock_allowed=$(val "$(prop sys.oem_unlock_allowed)")"
    echo "ro_secure=$(val "$(prop ro.secure)")"
    echo "ro_debuggable=$(val "$(prop ro.debuggable)")"
    echo "build_type=$(val "$(prop ro.build.type)")"
    echo "build_tags=$(val "$(prop ro.build.tags)")"
}

backend_info() {
    root_backend=none
    [ -d /data/adb/ksu ] && root_backend=KernelSU/SukiSU
    [ -d /data/adb/ap ] && root_backend=APatch
    [ -d /data/adb/magisk ] && root_backend=Magisk
    echo "root_backend=$root_backend"

    if pm path com.hzzmonet.kaorios.toolbox >/dev/null 2>&1 ||        pm list packages 2>/dev/null | grep -qi kaorios; then
        echo "kaorios=present"
    elif [ -d /system_ext/priv-app/KaoriosToolbox ] || [ -d /product/priv-app/KaoriosToolbox ]; then
        echo "kaorios=present"
    else
        echo "kaorios=not_detected"
    fi

    if pm path org.frknkrc44.hma_oss >/dev/null 2>&1; then
        echo "hma=present"
    else
        echo "hma=not_detected"
    fi

    susfs_bin=
    for exe in /data/adb/ksu/bin/ksu_susfs /data/adb/ap/bin/ap_susfs /data/adb/modules/susfs4ksu/ksu_susfs /system/bin/ksu_susfs; do
        [ -x "$exe" ] && { susfs_bin="$exe"; break; }
    done
    if [ -n "$susfs_bin" ] && command -v timeout >/dev/null 2>&1; then
        susfs_ver="$(timeout -s KILL 3 "$susfs_bin" show version 2>/dev/null)"
        susfs_features="$(timeout -s KILL 3 "$susfs_bin" show enabled_features 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
        if [ -n "$susfs_ver" ]; then
            echo "susfs=present"
            echo "susfs_version=$susfs_ver"
            echo "susfs_features=$(val "$susfs_features")"
        else
            echo "susfs=userspace_only_or_unavailable"
        fi
    else
        echo "susfs=not_detected"
    fi
}

print_live() {
    echo "HyperMOS VNeID Diagnostics"
    echo "=========================="
    echo "[VNeID]"
    package_info
    echo
    echo "[Identity]"
    identity_info
    echo
    echo "[Boot/Security - reported values]"
    security_info
    echo
    echo "[Related backends - detection only]"
    backend_info
}

snapshot() {
    [ "$(id -u)" = 0 ] || exit 0
    [ ! -L "$STATE" ] || exit 0
    mkdir -p "$STATE" || exit 0
    chmod 0700 "$STATE" 2>/dev/null || true
    tmp="$STATE/status.tmp"
    {
        echo "boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
        echo "captured_at=$(date +%s 2>/dev/null)"
        print_live
    } > "$tmp" && mv "$tmp" "$STATE/status"
}

case "${1:-status}" in
    boot)
        snapshot
        exit 0
        ;;
    status|all)
        print_live
        if [ -r "$STATE/status" ]; then
            echo
            echo "[Last boot snapshot]"
            sed -n '1,2p' "$STATE/status"
        fi
        ;;
    snapshot)
        snapshot
        [ -r "$STATE/status" ] && cat "$STATE/status"
        ;;
    features)
        cat <<'EOF'
vneid_package_detection=true
identity_report=true
boot_security_report=true
kaorios_detection=true
hma_detection=true
susfs_detection=true
runtime_property_mutation=false
fingerprint_mutation=false
susfs_mutation=false
attestation_policy_mutation=false
boot_state_spoof=false
root_hiding=false
guardian_daemon=false
uname_spoof=false
cache_cleanup=false
EOF
        ;;
    help|-h|--help)
        cat <<'EOF'
Usage: vneid-compatctl [status|all|snapshot|features]

status/all  Read the current environment relevant to com.vnid.
snapshot    Save a root-only diagnostic snapshot under /data/adb/vneid_compat.
features    Show exactly what this adapter does and does not do.

This tool is diagnostic-only and does not change VNeID, Android properties,
attestation policy, SuSFS rules, HMA rules, or boot/security state.
EOF
        ;;
    *)
        echo "Unknown command: $1" >&2
        exit 64
        ;;
esac

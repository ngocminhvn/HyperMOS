# Root backend domain is selected at ROM build time (KernelSU/SukiSU by default).
# An unavailable root domain prevents this optional service from starting;
# it must never prevent Android from booting.
service hcl_compat /system/bin/sh @HCL_CTL@ boot
    class late_start
    user root
    group root
    seclabel @HCL_DOMAIN@
    disabled
    oneshot
    timeout_period 45

on property:sys.boot_completed=1
    start hcl_compat

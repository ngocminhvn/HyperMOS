#!/system/bin/sh
# HCL-inspired compatibility adapter. No framework/keystore ownership here.
# This file has no .sh suffix: UpdateFile recursively executes every *.sh.
STATE=/data/adb/hypermos_hcl
DEFAULTS=@HCL_DEFAULTS@
SELF=@HCL_CTL@
PATH=/system/bin:/system/xbin:/system_ext/bin:/product/bin:/vendor/bin
export PATH
umask 077

prop() { getprop "$1" 2>/dev/null; }
record() { printf '%s=%s\n' "$1" "$2" >> "$RUN/status"; }
# Both init and each optional native backend have deadlines. Never wait for root.
bounded() { timeout -s KILL 3 "$@"; }

load_config() {
    enabled=true normalize_identity=true normalize_fingerprint=true
    generate_compat=true discover_components=true susfs=true
    cfg=$DEFAULTS
    [ ! -f "$STATE/config.conf" ] || cfg=$STATE/config.conf
    [ -r "$cfg" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        key=${line%%=*}; value=${line#*=}
        case "$value" in true|false) ;; *) return 1 ;; esac
        case "$key" in
            enabled) enabled=$value ;;
            normalize_identity) normalize_identity=$value ;;
            normalize_fingerprint) normalize_fingerprint=$value ;;
            generate_compat) generate_compat=$value ;;
            discover_components) discover_components=$value ;;
            susfs) susfs=$value ;;
            *) return 1 ;;
        esac
    done < "$cfg"
}

choose() {
    for key in "$@"; do
        val=$(prop "$key")
        case "$val" in ''|unknown|Unknown|Android|generic|mainline|missi|qssi) continue ;; esac
        printf '%s\n' "$val"
        return 0
    done
}

detect() {
    ROM=aosp
    if [ -n "$(prop ro.mi.os.version.name)$(prop ro.miui.ui.version.name)$(prop ro.miui.ui.version.code)" ] ||
       [ -f /system/framework/framework-ext-res.apk ]; then
        ROM=hyperos
    elif [ -n "$(prop ro.lineage.version)" ]; then ROM=lineage
    elif [ -n "$(prop ro.crdroid.version)" ]; then ROM=crdroid
    elif [ -n "$(prop ro.evolution.version)" ]; then ROM=evolution
    fi
    DEVICE=$(choose ro.product.vendor.device ro.product.odm.device ro.product.device)
    MODEL=$(choose ro.product.vendor.model ro.product.odm.model ro.product.model)
    BRAND=$(choose ro.product.vendor.brand ro.product.odm.brand ro.product.brand)
    MANUFACTURER=$(choose ro.product.vendor.manufacturer ro.product.odm.manufacturer ro.product.manufacturer)
    NAME=$(choose ro.product.vendor.name ro.product.odm.name ro.product.name)
    RELEASE=$(prop ro.build.version.release)
    FP=
    # Prefer hardware-specific vendor identity over Xiaomi's generic system image.
    # Never synthesize a fingerprint, release, build ID, model, or security patch.
    for key in ro.vendor.build.fingerprint ro.build.fingerprint ro.odm.build.fingerprint; do
        candidate=$(prop "$key")
        if printf '%s\n' "$candidate" | awk -F'[/ :]' -v device="$DEVICE" -v rel="$RELEASE" '
            NF == 8 && $3 == device && $4 == rel && $1 != "" && $2 != "" &&
            $5 != "" && $6 != "" && $7 != "" && $8 != "" {ok=1}
            END {exit !ok}'; then
            FP=$candidate; break
        fi
    done
    SRC=
    for file in /system/build.prop /system/system/build.prop; do
        if [ -r "$file" ]; then SRC=$file; break; fi
    done
}

find_resetprop() {
    RESET= RESET_MODE=plain
    for exe in /data/adb/ksu/bin/resetprop /data/adb/ap/bin/resetprop /data/adb/magisk/resetprop /system/bin/resetprop /system/xbin/resetprop; do
        if [ -x "$exe" ]; then RESET=$exe; return; fi
    done
    if [ -x /data/adb/magisk/magisk ]; then
        RESET=/data/adb/magisk/magisk; RESET_MODE=magisk
    fi
}

allowed_key() {
    # Defense in depth: no security/AVB, keybox, build type/tags or patch-level keys.
    case "$1" in
        ro.product.device|ro.product.model|ro.product.name|ro.product.brand|ro.product.manufacturer|ro.build.product|ro.build.fingerprint) return 0 ;;
    esac
    for part in system system_ext product vendor odm bootimage vendor_dlkm odm_dlkm; do
        case "$1" in
            ro.product.$part.device|ro.product.$part.model|ro.product.$part.name|ro.product.$part.brand|ro.product.$part.manufacturer|ro.$part.build.fingerprint) return 0 ;;
        esac
    done
    return 1
}

plan_property() {
    [ -n "$2" ] && allowed_key "$1" || return 0
    # Only normalize properties that exist. Do not invent optional partitions.
    [ -n "$(prop "$1")" ] || return 0
    printf '%s=%s\n' "$1" "$2" >> "$RUN/desired.prop"
}

plan_identity() {
    : > "$RUN/desired.prop"
    if [ "$normalize_identity" = true ]; then
        for prefix in ro.product ro.product.system ro.product.system_ext ro.product.product ro.product.vendor ro.product.odm ro.product.bootimage ro.product.vendor_dlkm ro.product.odm_dlkm; do
            plan_property "$prefix.device" "$DEVICE"
            plan_property "$prefix.model" "$MODEL"
            plan_property "$prefix.name" "$NAME"
            plan_property "$prefix.brand" "$BRAND"
            plan_property "$prefix.manufacturer" "$MANUFACTURER"
        done
        plan_property ro.build.product "$DEVICE"
    fi
    if [ "$normalize_fingerprint" = true ] && [ -n "$FP" ]; then
        plan_property ro.build.fingerprint "$FP"
        for part in system system_ext product vendor odm bootimage vendor_dlkm odm_dlkm; do
            plan_property "ro.$part.build.fingerprint" "$FP"
        done
    fi
}

apply_properties() {
    changed=0 failed=0
    : > "$RUN/effective.prop"
    while IFS='=' read -r key value; do
        allowed_key "$key" || continue
        old=$(prop "$key")
        if [ "$old" != "$value" ] && [ -n "$RESET" ]; then
            if [ "$RESET_MODE" = magisk ]; then
                bounded "$RESET" --resetprop -n "$key" "$value" >/dev/null 2>&1 || true
            else
                bounded "$RESET" -n "$key" "$value" >/dev/null 2>&1 || true
            fi
            if [ "$(prop "$key")" = "$value" ]; then
                changed=$((changed + 1))
            else
                failed=$((failed + 1))
            fi
        fi
        # File view must describe actual runtime results, including denied writes.
        actual=$(prop "$key")
        [ -z "$actual" ] || printf '%s=%s\n' "$key" "$actual" >> "$RUN/effective.prop"
    done < "$RUN/desired.prop"
    record properties_changed "$changed"
    record properties_failed "$failed"
    record resetprop "${RESET:-unavailable}"
}

generate_view() {
    [ "$generate_compat" = true ] || { record compat disabled; return; }
    [ -n "$SRC" ] || { record compat missing_source; return; }
    # Exact keys only. Preserve comments, unrelated properties and security state.
    if awk 'FILENAME == ARGV[1] {i=index($0,"="); if(i) values[substr($0,1,i-1)]=substr($0,i+1); next}
        {i=index($0,"="); k=substr($0,1,i-1); if(i && k in values) print k "=" values[k]; else print}' \
        "$RUN/effective.prop" "$SRC" > "$RUN/compat_build.prop"; then
        record compat generated
    else
        rm -f "$RUN/compat_build.prop"
        record compat failed
    fi
}

discover() {
    : > "$RUN/components.txt"
    [ "$discover_components" = true ] || return 0
    # Inventory only until the optional SuSFS backend succeeds. Never delete APKs.
    for base in /product/priv-app /product/app /system_ext/priv-app /system_ext/app /system/priv-app /system/app; do
        [ -d "$base" ] || continue
        find "$base" -maxdepth 3 \( -type d -o -type f \) \( \
            -iname '*xiaomieu*' -o -iname '*hypertn*' -o -iname '*tntoolbox*' -o \
            -iname '*eliterom*' -o -iname '*mipa*' -o -iname '*pulse*' -o \
            -iname '*lineage.updater*' -o -iname '*crdroid.updater*' \) \
            2>/dev/null >> "$RUN/components.txt"
    done
    for item in /system/addon.d /system/system/addon.d /system_ext/addon.d /product/addon.d; do
        [ ! -d "$item" ] || printf '%s\n' "$item" >> "$RUN/components.txt"
    done
    sort -u "$RUN/components.txt" > "$RUN/components.sorted"
    mv "$RUN/components.sorted" "$RUN/components.txt"
}

apply_susfs() {
    record susfs_requested "$susfs"
    [ "$susfs" = true ] || { record susfs disabled; return; }
    SUSFS= VERSION= FEATURES=
    for exe in /data/adb/ksu/bin/ksu_susfs /data/adb/ap/bin/ap_susfs /data/adb/modules/susfs4ksu/ksu_susfs /system/bin/ksu_susfs; do
        [ -x "$exe" ] || continue
        version=$(bounded "$exe" show version 2>/dev/null) || continue
        # A binary's existence, LKM label, or kernel name is not kernel support.
        printf '%s\n' "$version" | grep -Eq '^v?[0-9]+\.[0-9]+\.[0-9]+$' || continue
        features=$(bounded "$exe" show enabled_features 2>/dev/null) || continue
        printf '%s\n' "$features" | grep -q 'CONFIG_KSU_SUSFS_' || continue
        SUSFS=$exe; VERSION=${version#v}; FEATURES=$features; break
    done
    [ -n "$SUSFS" ] || { record susfs unsupported_or_unavailable; return; }
    record susfs_version "$VERSION"
    record susfs supported
    sus_ok=0 sus_fail=0
    if printf '%s\n' "$FEATURES" | grep -Eq '^CONFIG_KSU_SUSFS_SUS_PATH(=y)?$'; then
        while IFS= read -r item; do
            [ -e "$item" ] || continue
            if bounded "$SUSFS" add_sus_path "$item" >/dev/null 2>&1; then
                sus_ok=$((sus_ok + 1))
            else sus_fail=$((sus_fail + 1)); fi
        done < "$RUN/components.txt"
    fi
    record sus_paths_applied "$sus_ok"
    record sus_paths_failed "$sus_fail"
    if ! printf '%s\n' "$FEATURES" | grep -Eq '^CONFIG_KSU_SUSFS_OPEN_REDIRECT(=y)?$'; then
        record susfs_redirect unsupported; return
    fi
    [ -f "$RUN/compat_build.prop" ] && [ -n "$SRC" ] || { record susfs_redirect no_view; return; }
    # Keep each published target inode alive until reboot; no shared module config.
    target=/mnt/vendor/susfs4ksu/hypermos_hcl
    if { [ ! -d "${target%/*}" ] && ! mkdir -m 0755 "${target%/*}"; } ||
       ! mkdir -p "$target" || ! chmod 0755 "$target" || ! cp "$RUN/compat_build.prop" "$target/compat.$$.prop" ||
       ! chmod 0644 "$target/compat.$$.prop" || ! chcon u:object_r:system_file:s0 "$target/compat.$$.prop"; then
        record susfs_redirect target_unavailable; return
    fi
    target=$target/compat.$$.prop
    case "$VERSION" in
        1.5.*|2.0.*) bounded "$SUSFS" add_open_redirect "$SRC" "$target" >/dev/null 2>&1 ;;
        2.*) bounded "$SUSFS" add_open_redirect "$SRC" "$target" 3 >/dev/null 2>&1 ;;
        *) record susfs_redirect unknown_abi; return ;;
    esac
    rc=$?
    if [ "$rc" = 0 ]; then record susfs_redirect applied
    else record susfs_redirect failed; fi
}

run_once() (
    [ "$(id -u)" = 0 ] || { echo 'Root is required for apply.' >&2; exit 1; }
    command -v timeout >/dev/null 2>&1 || { echo 'HCL skipped: timeout unavailable'; exit 0; }
    [ ! -L "$STATE" ] || exit 0
    mkdir -p "$STATE" && chmod 0700 "$STATE" || exit 0
    # flock lock is released on exit/SIGKILL; no stale boot lock or daemon.
    command -v flock >/dev/null 2>&1 || { echo 'HCL skipped: flock unavailable'; exit 0; }
    exec 9>"$STATE/run.lock"
    flock -n 9 || exit 0
    RUN=$(mktemp -d "$STATE/run.XXXXXX") || exit 0
    trap 'rm -rf "$RUN"' EXIT
    record boot_id "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
    record started "$(date +%s)"
    # Publish running status, so timeout/crash cannot leave a stale success report.
    { cat "$RUN/status"; echo 'result=running'; } > "$STATE/status.new"
    mv "$STATE/status.new" "$STATE/status"
    if [ ! -e "$STATE/config.conf" ]; then
        cp "$DEFAULTS" "$STATE/config.conf" || exit 0
    fi
    if ! load_config; then
        record result invalid_config
    elif [ "$enabled" != true ]; then
        record result disabled
    else
        detect
        record rom "$ROM"
        record device "$DEVICE"
        record model "$MODEL"
        record fingerprint "${FP:-no_matching_candidate}"
        find_resetprop
        plan_identity
        apply_properties
        generate_view
        discover
        apply_susfs
        record result completed
    fi
    for file in desired.prop effective.prop compat_build.prop components.txt; do
        if [ -f "$RUN/$file" ]; then mv "$RUN/$file" "$STATE/$file"
        else rm -f "$STATE/$file"; fi
    done
    mv "$RUN/status" "$STATE/status"
    cat "$STATE/status"
)

# Diagnostics are sourced from an adjacent immutable ROM file, never from /data.
case "${1:-status}" in
    boot) run_once; exit 0 ;;
    apply) run_once; exit $? ;;
    config)
        if [ -f "$STATE/config.conf" ]; then cat "$STATE/config.conf"; else cat "$DEFAULTS"; fi
        ;;
    set)
        [ "$(id -u)" = 0 ] || exit 1
        case "${2:-}" in enabled|normalize_identity|normalize_fingerprint|generate_compat|discover_components|susfs) ;; *) exit 2 ;; esac
        case "${3:-}" in true|false) ;; *) exit 2 ;; esac
        [ ! -L "$STATE" ] || exit 1
        mkdir -p "$STATE" && chmod 0700 "$STATE" || exit 1
        exec 9>"$STATE/run.lock"
        flock -n 9 || exit 1
        load_config || { echo 'Invalid config; repair config.conf first' >&2; exit 1; }
        cfg=$DEFAULTS; [ ! -f "$STATE/config.conf" ] || cfg=$STATE/config.conf
        awk -F= -v k="$2" -v v="$3" '$1 == k {if(!seen++) print k "=" v; next} {print} END {if(!seen) print k "=" v}' "$cfg" > "$STATE/config.new" &&
            mv "$STATE/config.new" "$STATE/config.conf" || exit 1
        echo 'Saved. Apply or reboot; disabling existing property/SuSFS changes requires reboot.'
        ;;
    *) . "${SELF%/*}/hcl-diagnostics" ;;
esac

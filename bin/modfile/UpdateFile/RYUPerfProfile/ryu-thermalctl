#!/system/bin/sh
# On-demand configuration of PerfHook's Settings.System observer.
set -eu
settings_bin=${RYU_SETTINGS_BIN:-/system/bin/settings}
user=${RYU_SETTINGS_USER:-0}
get() { "$settings_bin" --user "$user" get system "$1"; }
put() { "$settings_bin" --user "$user" put system "$1" "$2"; }
# IDs verified against original RYU HAOTIAN thermal-odm-map.conf.
# Charge, No Limits and TGame remain outside this manual selector.
resolve() {
    case "$1" in
        normal) id=0; file=normal ;;
        performance) id=50; file=per-normal ;;
        hp) id=500; file=hp-normal ;;
        game) id=700; file=cgame ;;
        huanji) id=1; file=huanji ;;
        phone) id=5; file=phone ;;
        class0) id=7; file=class0 ;;
        arvr) id=9; file=arvr ;;
        navigation) id=10; file=navigation ;;
        video) id=11; file=video ;;
        videochat) id=14; file=videochat ;;
        camera) id=15; file=camera ;;
        4k) id=16; file=4k ;;
        mgame) id=19; file=mgame ;;
        per-class0) id=57; file=per-class0 ;;
        per-video) id=61; file=per-video ;;
        hp-mgame) id=501; file=hp-mgame ;;
        cclassvideo) id=701; file=cclassvideo ;;
        *) echo "Unknown profile: $1" >&2; exit 2 ;;
    esac
}
profile() {
    resolve "$1"
    test -s "${RYU_PROFILE_ROOT:-/odm/etc}/thermal-$file.conf" || {
        echo "Profile file missing: thermal-$file.conf" >&2; exit 2;
    }
}
# Serialize writes from all clients, including separate root invocations.
# Read-only status/profile discovery never takes this lock.
restore_setting() {
    if [ "$2" = null ]; then
        "$settings_bin" --user "$user" delete system "$1" || return 1
    else
        put "$1" "$2" || return 1
    fi
    [ "$(get "$1")" = "$2" ]
}
finish() {
    result=$1
    trap - EXIT HUP INT TERM
    if [ "$committed" = 0 ] && [ "$snapshot_ready" = 1 ]; then
        rollback_failed=0
        restore_setting projectryu_thermal_per_app 0 || rollback_failed=1
        restore_setting projectryu_thermal_profiles "$old_profiles" || rollback_failed=1
        restore_setting projectryu_thermal_sconfig "$old_sconfig" || rollback_failed=1
        restore_setting projectryu_thermal_per_app "$old_mode" || rollback_failed=1
        if [ "$rollback_failed" = 1 ]; then
            echo 'Thermal apply failed; previous Settings could not be fully restored' >&2
        else
            echo 'Thermal apply failed; previous Settings restored' >&2
        fi
    fi
    rm -f "$lock/pid"
    rmdir "$lock" || true
    exit "$result"
}
begin() {
    umask 077
    state=${RYU_STATE_ROOT:-/data/adb/tnm/state}
    mkdir -p "$state"
    # Locks are scoped to this boot. Do not reap a dead PID here: competing
    # clients could otherwise delete a newly acquired lock after stale checks.
    # Normal exits/signals release it; a hard-killed writer needs a reboot.
    boot_id=${RYU_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id)}
    case "$boot_id" in ''|*[!a-zA-Z0-9-]*) echo 'Boot ID unavailable' >&2; exit 3 ;; esac
    lock="$state/thermal-$boot_id.lock"
    mkdir "$lock" 2>/dev/null || { echo 'Another thermal apply is running' >&2; exit 11; }
    committed=0; snapshot_ready=0
    trap 'finish $?' EXIT
    trap 'exit 130' INT
    trap 'exit 143' HUP TERM
    printf '%s\n' "$$" > "$lock/pid"
    old_mode=$(get projectryu_thermal_per_app)
    old_sconfig=$(get projectryu_thermal_sconfig)
    old_profiles=$(get projectryu_thermal_profiles)
    snapshot_ready=1
}
write_checked() {
    put "$1" "$2"
    [ "$(get "$1")" = "$2" ] || { echo "Setting not confirmed: $1" >&2; exit 4; }
}
case "${1:-status}" in
    status)
        for key in projectryu_thermal_per_app projectryu_thermal_sconfig projectryu_thermal_profiles; do
            printf '%s=%s\n' "$key" "$(get "$key")"
        done
        ;;
    profiles)
        test "$#" -eq 1 || exit 2
        for selected in normal performance hp game huanji phone class0 arvr navigation video videochat camera 4k mgame per-class0 per-video hp-mgame cclassvideo; do
            resolve "$selected"
            if test -s "${RYU_PROFILE_ROOT:-/odm/etc}/thermal-$file.conf"; then
                printf '%s:%s:%s\n' "$selected" "$id" "$file"
            fi
        done
        ;;
    global)
        test "$#" -eq 2 || { echo 'Usage: ryu-thermalctl global PROFILE' >&2; exit 2; }
        profile "$2"
        begin
        write_checked projectryu_thermal_per_app 0
        write_checked projectryu_thermal_sconfig "$id"
        committed=1
        ;;
    perapp)
        shift
        test "$#" -gt 0 && test "$#" -le 32 || { echo 'Usage: ryu-thermalctl perapp package:profile ...' >&2; exit 2; }
        profiles=''
        packages=','
        for entry in "$@"; do
            pkg=${entry%:*}; selected=${entry##*:}
            case "$pkg" in ''|*[!a-zA-Z0-9_.]*) echo 'Invalid package' >&2; exit 2 ;; esac
            test "$pkg" != "$entry" || { echo 'Profile delimiter missing' >&2; exit 2; }
            printf '%s\n' "$pkg" | grep -Eq '^[A-Za-z0-9_]+([.][A-Za-z0-9_]+)+$' || {
                echo 'Invalid package' >&2; exit 2;
            }
            case "$packages" in *",$pkg,"*) echo 'Duplicate package' >&2; exit 2 ;; esac
            packages="$packages$pkg,"
            profile "$selected"
            profiles="${profiles}${profiles:+,}${pkg}:${id}"
        done
        # Validate the complete batch before changing any setting.
        begin
        # Pause per-app observation before publishing a complete replacement.
        write_checked projectryu_thermal_per_app 0
        write_checked projectryu_thermal_profiles "$profiles"
        write_checked projectryu_thermal_sconfig 0
        write_checked projectryu_thermal_per_app 1
        committed=1
        ;;
    *) echo 'Usage: ryu-thermalctl status|profiles|global PROFILE|perapp PACKAGE:PROFILE ...' >&2; exit 2 ;;
esac

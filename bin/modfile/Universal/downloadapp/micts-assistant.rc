# HyperMOS MiCTS assistant bootstrap.
# Run once after Android finishes booting. Use the shell SELinux domain because
# Android's RoleManager shell command is the same path verified over ADB.
# The helper preserves any explicitly selected non-Google assistant.

service hypermos-micts-assistant /system/bin/sh /product/bin/micts-assistantctl
    class late_start
    user shell
    group shell
    seclabel u:r:shell:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start hypermos-micts-assistant
